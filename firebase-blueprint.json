{
  "entities": {
    "FileRecord": {
      "title": "FileRecord",
      "description": "Metadata file transfer antara HP dan PC",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "originalName": { "type": "string", "maxLength": 512 },
        "filename": { "type": "string", "maxLength": 512 },
        "size": { "type": "number" },
        "mimetype": { "type": "string", "maxLength": 128 },
        "extension": { "type": "string", "maxLength": 32 },
        "uploadedAt": { "type": "string", "maxLength": 64 },
        "dateGroup": { "type": "string", "maxLength": 64 },
        "category": { "type": "string", "maxLength": 32 },
        "device": { "type": "string", "maxLength": 64 },
        "isHeic": { "type": "boolean" },
        "isMov": { "type": "boolean" },
        "syncedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "originalName", "filename", "size"]
    },
    "TextNote": {
      "title": "TextNote",
      "description": "Catatan teks cepat dan clipboard instan",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "content": { "type": "string", "maxLength": 10000 },
        "sender": { "type": "string", "maxLength": 100 },
        "timestamp": { "type": "string", "maxLength": 64 },
        "isLink": { "type": "boolean" },
        "syncedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "content", "sender", "timestamp"]
    },
    "SystemLog": {
      "title": "SystemLog",
      "description": "Log aktivitas sistem WiFi transfer",
      "type": "object",
      "properties": {
        "action": { "type": "string", "maxLength": 64 },
        "details": { "type": "string", "maxLength": 1000 },
        "timestamp": { "type": "string", "maxLength": 64 }
      },
      "required": ["action", "details", "timestamp"]
    },
    "SignalingSession": {
      "title": "SignalingSession",
      "description": "WebRTC P2P Signaling session antara PC dan HP",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "maxLength": 128 },
        "offer": { "type": "string" },
        "answer": { "type": "string" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["sessionId"]
    }
  },
  "firestore": {
    "/files/{fileId}": {
      "schema": "FileRecord",
      "description": "Koleksi metadata berkas yang ditransfer"
    },
    "/notes/{noteId}": {
      "schema": "TextNote",
      "description": "Koleksi catatan teks dan sinkronisasi clipboard"
    },
    "/system_logs/{logId}": {
      "schema": "SystemLog",
      "description": "Koleksi riwayat aktivitas transfer"
    },
    "/signaling_sessions/{sessionId}": {
      "schema": "SignalingSession",
      "description": "Koleksi sinyal WebRTC DataChannel"
    },
    "/signaling_sessions/{sessionId}/callerCandidates/{candidateId}": {
      "schema": "object",
      "description": "ICE candidates dari pengirim"
    },
    "/signaling_sessions/{sessionId}/calleeCandidates/{candidateId}": {
      "schema": "object",
      "description": "ICE candidates dari penerima"
    }
  }
}
