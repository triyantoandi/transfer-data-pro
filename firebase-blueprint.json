{
  "schemaVersion": "1.0.0",
  "collections": [
    {
      "id": "files",
      "description": "Metadata rekam jejak file yang ditransfer antara HP dan PC",
      "fields": [
        { "name": "id", "type": "string", "description": "Unique identifier file" },
        { "name": "originalName", "type": "string", "description": "Nama file asli" },
        { "name": "filename", "type": "string", "description": "Nama file tersimpan" },
        { "name": "size", "type": "number", "description": "Ukuran file dalam bytes" },
        { "name": "mimetype", "type": "string", "description": "MIME type file" },
        { "name": "extension", "type": "string", "description": "Ekstensi file" },
        { "name": "uploadedAt", "type": "string", "description": "Waktu upload ISO timestamp" },
        { "name": "dateGroup", "type": "string", "description": "Kelompok tanggal arsip (misal: 24 Agustus 2026)" },
        { "name": "category", "type": "string", "description": "Kategori file: photo, video, document, audio, archive, other" },
        { "name": "device", "type": "string", "description": "Nama perangkat pengirim (iPhone, Android, PC)" },
        { "name": "isHeic", "type": "boolean", "description": "Apakah format Apple HEIC/HEIF mentah" },
        { "name": "isMov", "type": "boolean", "description": "Apakah format video QuickTime MOV asli" }
      ]
    },
    {
      "id": "notes",
      "description": "Catatan teks, link website, dan sinkronisasi clipboard instan",
      "fields": [
        { "name": "id", "type": "string", "description": "Unique ID catatan" },
        { "name": "content", "type": "string", "description": "Isi teks atau URL" },
        { "name": "sender", "type": "string", "description": "Nama perangkat pengirim" },
        { "name": "timestamp", "type": "string", "description": "Waktu pembuatan ISO timestamp" },
        { "name": "isLink", "type": "boolean", "description": "Apakah isi catatan merupakan link valid" }
      ]
    },
    {
      "id": "system_logs",
      "description": "Log aktivitas transfer dan sinkronisasi server WiFi",
      "fields": [
        { "name": "action", "type": "string", "description": "Aktivitas yang terjadi" },
        { "name": "details", "type": "string", "description": "Rincian aktivitas" },
        { "name": "timestamp", "type": "string", "description": "Waktu log ISO" }
      ]
    }
  ]
}
